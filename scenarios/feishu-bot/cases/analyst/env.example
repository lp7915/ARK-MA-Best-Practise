# analyst case 配置样板:cp 到 ~/.arkagent/cases/analyst/config.env 后填写(文件权限 0600)
# `arkagent init --case analyst` 会写入前四项。
ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# 分析师研发环境资源
ANALYST_AGENT_ID="agent-20261102113314-9wmy8"
ANALYST_ENVIRONMENT_ID="env-20261102113308-y70ol"
ANALYST_VAULT_ID="vlt-20261102113309-pg0xq"
# 挂载的 Memory Store:逗号或换行分隔,格式 <store_id>[:read_only|read_write],逐个配置;
# 不写权限的默认 read_only(机器人只能读),read_write 才允许机器人新增/改写/删除记忆
ANALYST_MEMORY_STORES="memstore-20261102113309-4boi9:read_only"

# 产物存储(工作区统一走这里,不再做 TOS 资源挂载):机器人写入 /mnt/session/outputs/ 的文件落到这里
# (会话创建时覆写 Environment 的 config.tos,不修改 Environment 本身)。bucket 与 prefix 须同时填写,
# prefix 以 / 结尾;留空=沿用 Environment 配置。实际路径按 <prefix>users/<分析师 open_id>/<话题 thread_id,无则 chat_id>/
# 隔离,不同分析师、不同 Topic 互不覆盖;同一分析师同一 Topic 的 /new 新会话沿用同一目录。
ANALYST_OUTPUT_TOS_BUCKET="blueai-vlc-ma"
ANALYST_OUTPUT_TOS_PREFIX="blueai-ma/analyst-workspace/"

# 允许使用的飞书 open_id 白名单(逗号分隔;留空=不限)
AUTHORIZED_OPEN_IDS=""

# BYOK Direct:模型鉴权 Header,两者需同时填写才生效(留空=不附加)
BYOK_MODEL_AUTH_HEADER_NAME=""
BYOK_MODEL_AUTH_HEADER_VALUE=""
