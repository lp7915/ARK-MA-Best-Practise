{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.pm-worker",
  "version": "1.2.0",
  "description": "pm 到单一执行方的版本化 Context",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "work_item": {
      "type": "string"
    },
    "recipient": {
      "enum": [
        "t",
        "g",
        "s",
        "validator",
        "h"
      ]
    },
    "confirmation_version": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rule_reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "production_required": {
          "type": "array",
          "items": {
            "enum": [
              "t",
              "g"
            ]
          },
          "uniqueItems": true
        },
        "require_validator": {
          "type": "boolean"
        },
        "upstream_results": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "向s交接时列出所需t/g及必要validator的实际完整标准返回JSON路径；相对路径按Workspace定位。"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "upstream_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected": {
      "type": "string"
    },
    "context_version": {
      "type": "integer"
    }
  },
  "required": [
    "task_id",
    "run_id",
    "work_item",
    "recipient",
    "confirmation_version",
    "sources",
    "rule_reads",
    "scope",
    "inputs",
    "upstream_artifacts",
    "expected",
    "context_version"
  ],
  "examples": [
    {
      "task_id": "task-reference",
      "run_id": "run-reference",
      "work_item": "work-reference",
      "recipient": "t",
      "confirmation_version": 1,
      "sources": [
        {
          "ref": "input-reference",
          "read_status": "complete"
        }
      ],
      "rule_reads": [
        "knowledge/standards/context.md"
      ],
      "scope": {
        "object": "合成对象",
        "production_required": [
          "t"
        ],
        "require_validator": true
      },
      "inputs": [
        "adopted-input.json"
      ],
      "upstream_artifacts": [],
      "expected": "阶段报告及支撑数据",
      "context_version": 1
    }
  ]
}
