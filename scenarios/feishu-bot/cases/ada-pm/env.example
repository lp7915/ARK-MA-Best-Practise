# ada-pm case 配置样板:cp 到 ~/.arkagent/cases/ada-pm/config.env 后填写(文件权限 0600)
# `arkagent init --case ada-pm` 会写入前四项(ARK_API_KEY + 飞书凭据)。
ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# Ada PM 数字员工资源(pm 主 Agent + 一位数字员工一个 Environment)
ADA_PM_AGENT_ID="agent-20261111031721-c3d0679if2"
ADA_PM_ENVIRONMENT_ID="env-20261110154040-6l5so4zkup"

# 产物存储(会话级覆写 config.tos，对齐 analyst)：bucket 与 prefix 须同时填写、prefix 以 / 结尾;留空=沿用 Environment 配置。
# 实际落盘在 base prefix 下再按 users/<open_id>/<topic>/ 拆，不同会话/用户/话题互不覆盖(scope_output_by_user_topic=True)。
ADA_PM_OUTPUT_TOS_BUCKET="blueai-vlc-ma"
ADA_PM_OUTPUT_TOS_PREFIX="blueai-ma/topic-lab/ada-pm/"

# 挂载的知识库:逗号或换行分隔,格式 <store_id>[:read_only|read_write]。
# 5 个知识记忆库全部只读:pm 与 t/g/s/validator 在会话里共享只读读取。
# 缺省 read_only。
ADA_PM_MEMORY_STORES="memstore-20261110154040-p7lw5fucrp:read_only,memstore-20261110154040-tw1mww99zi:read_only,memstore-20261110154041-bq957cr15c:read_only,memstore-20261110154041-ly5op5z7uj:read_only,memstore-20261110154042-pu8ydgd2ro:read_only"

# 允许使用的飞书 open_id 白名单(逗号分隔;留空=不限)。demo 内测建议先填自己的 open_id。
AUTHORIZED_OPEN_IDS=""

# BYOK Direct:模型鉴权 Header,两者需同时填写才生效(留空=不附加)
BYOK_MODEL_AUTH_HEADER_NAME=""
BYOK_MODEL_AUTH_HEADER_VALUE=""